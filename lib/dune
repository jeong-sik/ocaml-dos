(library
 (name cpu86core)
 (public_name ocaml-dos.cpu86core)
 (wrapped false)
 (modules cpu86))

(library
 (name dosmachine)
 (public_name ocaml-dos.dosmachine)
 (wrapped false)
 ; cpu86 만 빼고 이 디렉터리의 모듈을 모두 쓴다 — 새 모듈을 더할 때 이 파일을 고치지 않는다.
 (modules :standard \ cpu86)
 (libraries cpu86core dos_core_identity))
