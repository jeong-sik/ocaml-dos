(library
 (name cpu86core)
 (public_name ocaml-dos.cpu86core)
 (wrapped false)
 (modules cpu86 cpu86_state cpu86_fault cpu86_decode cpu86_alu cpu86_bcd cpu86_string cpu86_flow32 cpu86_system cpu86_exec32 cpu86_exec0f cpu86_exec)
 (private_modules cpu86_state cpu86_fault cpu86_decode cpu86_alu cpu86_bcd cpu86_string cpu86_flow32 cpu86_system cpu86_exec32 cpu86_exec0f cpu86_exec))

(library
 (name dosmachine)
 (public_name ocaml-dos.dosmachine)
 (wrapped false)
 ; Every module of this directory except cpu86core's, so a new dos_* module
 ; does not edit this file. A new cpu86_* module goes in both lists.
 (modules :standard \ cpu86 cpu86_state cpu86_fault cpu86_decode cpu86_alu cpu86_bcd cpu86_string cpu86_flow32 cpu86_system cpu86_exec32 cpu86_exec0f cpu86_exec)
 (libraries cpu86core dos_core_identity))
